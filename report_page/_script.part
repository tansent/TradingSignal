<script>
(() => {
  const C = () => dash.colors;
  const parse = (s) => new Date(s + 'T00:00:00Z');
  const md = d3.utcFormat('%-m月%-d日');
  const mdShort = d3.utcFormat('%-m/%-d');
  const ymd = d3.utcFormat('%Y年%-m月%-d日');
  const f0 = d3.format(',.0f'), f1 = d3.format(',.1f'), f2 = d3.format(',.2f');
  const sgn1 = (v) => (v > 0 ? '+' : '') + f1(v);
  const sgn2 = (v) => (v > 0 ? '+' : '') + f2(v);
  const nv = (v, f) => (v == null ? '—' : f(v));
  const zoneMid = (v) => v < 20 ? '恐慌区' : v < 40 ? '偏冷' : v < 60 ? '中性' : v < 80 ? '偏热' : '过热区';
  const zoneShort = (v) => v < 10 ? '短期极冷（易反弹）' : v > 90 ? '短期极热' : '短期中性';
  const zoneHeat = (v) => v < 20 ? '极冷' : v < 40 ? '偏冷' : v < 60 ? '中性' : v < 90 ? '偏热' : '极热';
  const PX = { sh: '上证指数', hs300: '沪深300', sz: '深证成指', cyb: '创业板指', kc50: '科创50' };
  const SIG = { B3: { label: '★★B 三级底部', color: 'var(--color-bad)', sym: '★' },
    S: { label: '★S 二级顶部', color: 'var(--color-ok)', sym: '▼', above: true }, S1: { label: '▽S 一级顶部', color: 'var(--color-ok)', sym: '▽', above: true },
    SG: { label: '乖S 乖离顶', color: 'var(--color-ok)', sym: '乖', above: true },
    B2: { label: '★B 二级底部', color: 'var(--color-bad)', sym: '▲' }, B1: { label: '△B 一级底部', color: 'var(--color-warn)', sym: '△' },
    M: { label: '破 跌破月线BBI', color: 'var(--color-fg-muted)', sym: '破', above: true } };
  let pxKey = 'sh';

  const legend = document.getElementById('sig-legend');
  legend.replaceChildren(...Object.values(SIG).map((s) => {
    const sp = document.createElement('span');
    const i = document.createElement('span'); i.textContent = s.sym; i.style.color = s.color;
    sp.append(i, document.createTextNode(s.label)); return sp;
  }));
  const hideTips = (except) => document.querySelectorAll('.rp-tip').forEach((t) => {
    if (!except || !t.parentElement.contains(except)) { t.hidden = true; if (t.parentElement.__hide) t.parentElement.__hide(); }
  });
  document.addEventListener('pointermove', (e) => hideTips(e.target), { passive: true });
  document.addEventListener('pointerdown', (e) => hideTips(e.target), { passive: true });
  document.addEventListener('scroll', () => hideTips(null), { passive: true, capture: true });
  document.addEventListener('pointerleave', () => hideTips(null));
  window.addEventListener('blur', () => hideTips(null));
  const sel = document.getElementById('px-sel');
  sel.addEventListener('change', () => { pxKey = sel.value; dash.setParams({ px: sel.value }); });

  function fail(box) { box.querySelectorAll('svg').forEach((s) => s.remove()); const d = document.createElement('div'); d.className = 'rp-fail'; d.textContent = 'Failed to load'; box.appendChild(d); }
  function setMark(sel, txt) { document.querySelectorAll(sel).forEach((el) => { el.textContent = txt; el.classList.remove('dash-skeleton'); }); }
  function measure(svg, texts) {
    const t = svg.append('text').attr('class', 'rp-lbl').attr('x', -999).attr('y', -999);
    let w = 0; texts.forEach((s) => { t.text(s); w = Math.max(w, t.node().getComputedTextLength()); }); t.remove(); return w;
  }
  function tipBox(box) { let t = box.querySelector(':scope > .rp-tip'); if (!t) { t = document.createElement('div'); t.className = 'rp-tip'; t.hidden = true; box.appendChild(t); } return t; }
  function tipRow(color, name, value) {
    const r = document.createElement('div');
    if (color) { const s = document.createElement('span'); s.className = 'sw'; s.style.background = color; r.appendChild(s); }
    r.appendChild(document.createTextNode(name ? name + ' ' + value : value)); return r;
  }
  function tipHead(date) { const h = document.createElement('div'); h.className = 'd'; h.textContent = ymd(parse(date)); return h; }
  function placeTip(tip, box, x, y) {
    tip.hidden = false; const bw = box.clientWidth, tw = tip.offsetWidth;
    tip.style.left = Math.max(0, Math.min(bw - tw, x + 12)) + 'px'; tip.style.top = Math.max(0, y - 10) + 'px';
  }
  function gridY(svg, y, ticks, x0, x1, fmt) {
    svg.append('g').selectAll('line').data(ticks).join('line').attr('x1', x0).attr('x2', x1).attr('y1', (d) => y(d)).attr('y2', (d) => y(d)).attr('stroke', 'var(--cds-chart-grid)');
    svg.append('g').attr('class', 'rp-axis').selectAll('text').data(ticks).join('text').attr('x', x0 - 6).attr('y', (d) => y(d)).attr('dy', '0.32em').attr('text-anchor', 'end').text(fmt);
  }

  // 单张折线图（时间轴）
  function lineChart(box, rows, o) {
    box.querySelectorAll('svg').forEach((s) => s.remove()); tipBox(box).hidden = true;
    const W = Math.max(260, box.clientWidth), H = o.height || 210;
    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);
    const vals = o.series.flatMap((s) => rows.map((r) => r[s.key]).filter((v) => v != null));
    let dom = o.y || d3.extent(vals); if (!o.y) { const pad = (dom[1] - dom[0]) * 0.08 || 1; dom = [dom[0] - pad, dom[1] + pad]; }
    const y = d3.scaleLinear().domain(dom);
    const ticks = o.yTicks || y.ticks(4); const yf = o.yFmt || f0;
    const endTexts = o.endLabels ? o.series.map((s) => { const last = [...rows].reverse().find((r) => r[s.key] != null); return last ? s.label + ' ' + (s.fmt || yf)(last[s.key]) : ''; }) : [];
    const m = { t: 10, b: 22, l: measure(svg, ticks.map(yf)) + 8, r: o.endLabels ? measure(svg, endTexts) + 10 : 12 };
    y.range([H - m.b, m.t]);
    const x = d3.scaleUtc().domain(d3.extent(rows, (r) => parse(r.date))).range([m.l, W - m.r]);
    (o.bands || []).forEach((b) => svg.append('rect').attr('x', m.l).attr('width', W - m.l - m.r).attr('y', y(b.y1)).attr('height', Math.max(0, y(b.y0) - y(b.y1))).attr('fill', b.fill).attr('opacity', 0.12));
    (o.xbands || []).forEach((b) => { const a = x(parse(b.from)), z = x(parse(b.to)); svg.append('rect').attr('x', a).attr('width', Math.max(1, z - a)).attr('y', m.t).attr('height', H - m.b - m.t).attr('fill', b.fill).attr('opacity', 0.1); });
    gridY(svg, y, ticks, m.l, W - m.r, yf);
    const nx = Math.max(2, Math.min(6, Math.floor((W - m.l - m.r) / 90)));
    svg.append('g').attr('class', 'rp-axis').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(nx).tickFormat(o.xFmt || d3.utcFormat('%-m月')).tickSizeOuter(0)).attr('font-size', null).attr('font-family', null)
      .call((g) => g.selectAll('.domain,line').attr('stroke', 'var(--cds-chart-axis)'));
    (o.refs || []).forEach((v) => svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(v)).attr('y2', y(v)).attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 3'));
    o.series.forEach((s) => svg.append('path').datum(rows).attr('fill', 'none').attr('stroke', s.color).attr('stroke-width', s.width || 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round')
      .attr('stroke-dasharray', s.dash || null).attr('d', d3.line().defined((r) => r[s.key] != null).x((r) => x(parse(r.date))).y((r) => y(r[s.key]))));
    if (o.endLabels) {
      const pts = o.series.map((s, i) => { const last = [...rows].reverse().find((r) => r[s.key] != null); return last ? { y: y(last[s.key]), t: endTexts[i] } : null; }).filter(Boolean).sort((a, b) => a.y - b.y);
      for (let i = 1; i < pts.length; i++) if (pts[i].y - pts[i - 1].y < 13) pts[i].y = pts[i - 1].y + 13;
      pts.forEach((p) => svg.append('text').attr('class', 'rp-endlbl').attr('x', W - m.r + 6).attr('y', p.y).attr('dy', '0.32em').text(p.t));
    }
    (o.markers || []).forEach((mk) => svg.append('text').attr('x', x(parse(mk.date))).attr('y', y(mk.y) + (mk.below ? 17 : -8)).attr('text-anchor', 'middle')
      .attr('font-size', 15).attr('font-weight', 700).attr('fill', mk.color).attr('stroke', 'var(--color-panel)').attr('stroke-width', 3).attr('paint-order', 'stroke').text(mk.sym));
    const tip = tipBox(box);
    const rule = svg.append('line').attr('y1', m.t).attr('y2', H - m.b).attr('stroke', 'var(--cds-chart-axis)').attr('opacity', 0);
    const dots = o.series.map((s) => svg.append('circle').attr('r', 3.5).attr('fill', s.color).attr('opacity', 0));
    const bis = d3.bisector((r) => parse(r.date)).center;
    svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')
      .on('pointermove', (ev) => {
        const [px] = d3.pointer(ev); const r = rows[bis(rows, x.invert(px))]; if (!r) return;
        const cx = x(parse(r.date)); rule.attr('x1', cx).attr('x2', cx).attr('opacity', 1);
        o.series.forEach((s, k) => { const v = r[s.key]; dots[k].attr('cx', cx).attr('cy', v == null ? -99 : y(v)).attr('opacity', v == null ? 0 : 1); });
        tip.replaceChildren(tipHead(r.date), ...o.series.map((s) => tipRow(o.series.length > 1 ? s.color : null, s.label, nv(r[s.key], s.fmt || yf))), ...(o.tipExtra ? o.tipExtra(r) : []));
        const bb = box.getBoundingClientRect(), sb = svg.node().getBoundingClientRect();
        placeTip(tip, box, (cx / W) * sb.width + (sb.left - bb.left), ev.clientY - bb.top);
      })
      .on('pointerleave', () => { tip.hidden = true; rule.attr('opacity', 0); dots.forEach((d) => d.attr('opacity', 0)); });
    box.__hide = () => { rule.attr('opacity', 0); dots.forEach((d) => d.attr('opacity', 0)); };
  }

  // 上：指数价格；下：指标（折线或正负柱）。共用按交易日排列的横轴，悬停同步。
  function pairChart(box, rows, price, o) {
    box.querySelectorAll('svg').forEach((s) => s.remove()); tipBox(box).hidden = true;
    const W = Math.max(260, box.clientWidth), Hp = 92, gap = 10, Hi = o.height || 150, H = Hp + gap + Hi + 22;
    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);
    const pv = rows.map((r) => price.get(r.date)).filter((v) => v != null);
    const yp = d3.scaleLinear().domain(d3.extent(pv)).nice(3);
    const pt = yp.ticks(3);
    let yi, it, ifmt = o.yFmt || f0;
    if (o.kind === 'bar') { yi = d3.scaleLinear().domain(d3.extent([0, ...rows.map((r) => r[o.barKey] ?? 0)])).nice(4); }
    else { const vs = o.series.flatMap((s) => rows.map((r) => r[s.key]).filter((v) => v != null)); yi = d3.scaleLinear().domain(o.y || d3.extent(vs)).nice(4); }
    it = o.yTicks || yi.ticks(4);
    const endTexts = o.kind === 'line' && o.series.length > 1 ? o.series.map((s) => { const last = [...rows].reverse().find((r) => r[s.key] != null); return last ? s.label + ' ' + (s.fmt || ifmt)(last[s.key]) : ''; }) : [];
    const m = { l: Math.max(measure(svg, pt.map(f0)), measure(svg, it.map(ifmt))) + 8, r: endTexts.length ? measure(svg, endTexts) + 10 : 10 };
    yp.range([Hp, 6]); yi.range([Hp + gap + Hi, Hp + gap + 4]);
    const x = d3.scaleBand().domain(rows.map((r) => r.date)).range([m.l, W - m.r]).padding(o.kind === 'bar' ? 0.2 : 0);
    const cx = (r) => x(r.date) + x.bandwidth() / 2;
    // 价格面板
    gridY(svg, yp, pt, m.l, W - m.r, f0);
    svg.append('text').attr('class', 'rp-lbl').attr('x', m.l + 4).attr('y', 14).text(PX[pxKey]);
    svg.append('path').datum(rows).attr('fill', 'none').attr('stroke', 'var(--color-fg-muted)').attr('stroke-width', 1.5).attr('stroke-linejoin', 'round')
      .attr('d', d3.line().defined((r) => price.get(r.date) != null).x(cx).y((r) => yp(price.get(r.date))));
    // 指标面板
    (o.bands || []).forEach((b) => svg.append('rect').attr('x', m.l).attr('width', W - m.l - m.r).attr('y', yi(b.y1)).attr('height', Math.max(0, yi(b.y0) - yi(b.y1))).attr('fill', b.fill).attr('opacity', 0.12));
    gridY(svg, yi, it, m.l, W - m.r, ifmt);
    if (o.kind === 'bar') {
      svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', yi(0)).attr('y2', yi(0)).attr('stroke', 'var(--cds-chart-axis)');
      const bw = Math.min(32, x.bandwidth());
      svg.append('g').selectAll('rect').data(rows).join('rect').attr('x', (r) => x(r.date) + (x.bandwidth() - bw) / 2).attr('width', bw)
        .attr('y', (r) => yi(Math.max(0, r[o.barKey] ?? 0))).attr('height', (r) => Math.abs(yi(r[o.barKey] ?? 0) - yi(0))).attr('rx', Math.min(2, bw / 2))
        .attr('fill', (r) => ((r[o.barKey] ?? 0) >= 0 ? o.pos : o.neg));
    } else {
      o.series.forEach((s) => svg.append('path').datum(rows).attr('fill', 'none').attr('stroke', s.color).attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round')
        .attr('d', d3.line().defined((r) => r[s.key] != null).x(cx).y((r) => yi(r[s.key]))));
      if (endTexts.length) {
        const pts = o.series.map((s, i) => { const last = [...rows].reverse().find((r) => r[s.key] != null); return last ? { y: yi(last[s.key]), t: endTexts[i] } : null; }).filter(Boolean).sort((a, b) => a.y - b.y);
        for (let i = 1; i < pts.length; i++) if (pts[i].y - pts[i - 1].y < 13) pts[i].y = pts[i - 1].y + 13;
        pts.forEach((p) => svg.append('text').attr('class', 'rp-endlbl').attr('x', W - m.r + 6).attr('y', p.y).attr('dy', '0.32em').text(p.t));
      }
    }
    // 横轴
    const n = Math.max(2, Math.floor((W - m.l - m.r) / 70)); const step = Math.ceil(rows.length / n);
    const xf = rows.length > 130 ? d3.utcFormat('%-m月') : mdShort;
    svg.append('g').attr('class', 'rp-axis').selectAll('text').data(rows.filter((r, i) => i % step === 0)).join('text')
      .attr('x', cx).attr('y', H - 6).attr('text-anchor', 'middle').text((r) => xf(parse(r.date)));
    // 悬停
    const tip = tipBox(box);
    const rule = svg.append('line').attr('y1', 4).attr('y2', Hp + gap + Hi).attr('stroke', 'var(--cds-chart-axis)').attr('opacity', 0);
    svg.append('rect').attr('x', m.l).attr('y', 0).attr('width', W - m.l - m.r).attr('height', Hp + gap + Hi).attr('fill', 'transparent')
      .on('pointermove', (ev) => {
        const [px] = d3.pointer(ev); const i = Math.max(0, Math.min(rows.length - 1, Math.floor((px - m.l) / x.step()))); const r = rows[i];
        rule.attr('x1', cx(r)).attr('x2', cx(r)).attr('opacity', 1);
        tip.replaceChildren(tipHead(r.date), tipRow(null, PX[pxKey], nv(price.get(r.date), f2)), ...o.tip(r));
        const bb = box.getBoundingClientRect(), sb = svg.node().getBoundingClientRect();
        placeTip(tip, box, (cx(r) / W) * sb.width + (sb.left - bb.left), ev.clientY - bb.top);
      })
      .on('pointerleave', () => { tip.hidden = true; rule.attr('opacity', 0); });
    box.__hide = () => rule.attr('opacity', 0);
  }

  function fillTable(sel, rows, cells) {
    const body = document.querySelector(sel + ' tbody');
    body.replaceChildren(...rows.map((r) => { const tr = document.createElement('tr'); cells(r).forEach((c) => { const td = document.createElement('td'); td.textContent = c; tr.appendChild(td); }); return tr; }));
  }

  // 把 wz 序列（1 顶部 / -1 底部 / 0）合成连续区间，用于图上的底色
  function zoneBands(rows, key) {
    const out = []; let cur = null;
    rows.forEach((r) => {
      const v = r[key] || 0;
      if (cur && v !== cur.v) { out.push(cur); cur = null; }
      if (!cur && v) cur = { v, from: r.date };
      if (cur) cur.to = r.date;
    });
    if (cur) out.push(cur);
    return out.map((b) => ({ from: b.from, to: b.to, fill: b.v > 0 ? 'var(--color-ok)' : 'var(--color-bad)' }));
  }

  // 重要提醒：主要指数出现 ★★B、★B、橙色 ◆S、红色 ◆S 时写在日报最上面
  function alerts(s, idx) {
    const by = (k) => idx.filter((r) => r.group !== '红利' && (r.signal || '').split('、').includes(k)).map((r) => r.name);
    const out = [], b3 = by('★★B'), b2 = by('★B');
    if (b3.length) out.push([`★★B 三级底部：${b3.join('、')}`, '★B 叠加中线温度极低或国家队大额申购。2011 年以来 9 轮，之后一年内都有像样的反弹（最高涨幅中位约 +25%），约一半成为牛市起点；如果之后跌破当天低点，更像熊市里的反弹。']);
    if (b2.length) out.push([`★B 二级底部：${b2.join('、')}`, '收盘时恐慌确认（下跌家数 ≥92%）。之后 3 天内摸到 +3% 的比例约 45%，60 天上涨比例约 63%；在月线 BBI 向下的趋势里多是反弹，60 天内中位还会再跌约 7%。']);
    if (s.crowd_mark) out.push(['橙色 ◆S 抱团顶：全市场（红利类除外）', `A股拥挤度 ${f1(s.crowd)}%，且沪深300 在一年高点 5% 以内。2011 年以来 4 次里 3 次是阶段顶部，顶通常在之后 1～2 个月内出现；2014-12 那次之后是大牛市。`]);
    if (s.red_s) out.push([`红色 ◆S：${s.red_s}`, '橙色 ◆S 之后二次冲顶或形成 M 顶，比橙色 ◆S 更危险：2015 年以来之后 60 天下跌的比例约 78～82%，中位约 −10%。']);
    return out;
  }

  function takeaway(s, idx, us) {
    const parts = s.mid_temp != null
      ? [`${md(parse(s.date))}：中线温度${zoneMid(s.mid_temp)}，${zoneShort(s.short_temp)}，融资与成交额${s.heat != null ? zoneHeat(s.heat) : '暂缺'}。`]
      : [`${md(parse(s.date))}：`];
    if (s.gap_days > 0 && s.breadth_date) parts.push(`全市场个股数据只到 ${md(parse(s.breadth_date))}（缺 ${s.gap_days} 个交易日），温度和涨跌家数暂停在那天；打开通达信 → 盘后数据下载 补齐后再更新。指数情绪和信号不受影响。`);
    const by = (k) => idx.filter((r) => (r.signal || '').split('、').includes(k)).map((r) => r.name);
    const b3 = by('★★B'), b2 = by('★B'), b1 = by('△B'), st = by('★S'), mb = by('破');
    if (alerts(s, idx).length) parts.push('今天有重要信号，见上方「重要提醒」。');
    if (b1.length) parts.push(`${b1.join('、')}出现 △B 一级底部信号。`);
    const s1 = by('▽S'), sg = by('乖S');
    if (st.length) parts.push(`${st.join('、')}出现 ★S 二级顶部信号。`);
    if (s1.length) parts.push(`${s1.join('、')}出现 ▽S 一级顶部信号。`);
    if (sg.length) parts.push(`${sg.join('、')}出现 乖S 乖离顶（暴涨后天量收阴）：2010 年以来 30 次，之后 60 天下跌的比例约 83%；2014-12 那次之后继续大涨。`);
    if (mb.length) parts.push(`${mb.join('、')}收盘连续两天跌破月线 BBI。`);
    const wTop = idx.filter((r) => r.wzone === '顶部区域').map((r) => r.name), wBot = idx.filter((r) => r.wzone === '底部区域').map((r) => r.name);
    if (wTop.length || wBot.length) parts.push(`周线：${[wTop.length ? wTop.join('、') + '处于顶部区域' : '', wBot.length ? wBot.join('、') + '处于底部区域' : ''].filter(Boolean).join('，')}。`);
    const ntNear = idx.filter((r) => ['上证指数', '上证50', '沪深300'].includes(r.name) && r.nt_low != null && Math.abs(r.nt_vs_low) <= 0.02)
      .map((r) => `${r.name}（${f0(r.nt_low)}，现价${r.nt_vs_low >= 0 ? '高' : '低'} ${f1(Math.abs(r.nt_vs_low) * 100)}%）`);
    if (ntNear.length) parts.push(`接近国家队入场期最低点：${ntNear.join('、')}。`);
    const bInTop = idx.filter((r) => r.wzone === '顶部区域' && /△B|★B/.test(r.signal || '')).map((r) => r.name);
    if (bInTop.length) parts.push(`${bInTop.join('、')}的日线底部信号出现在周线顶部区域里：2015 年以来这种位置的 △B 之后 60 天上涨的比例约 37%，60 天内再跌的中位数约 15%。`);
    if (!b3.length && !b2.length && !b1.length && !st.length && !s1.length && !sg.length && !mb.length) parts.push('今天各指数没有顶底信号。');
    const os = idx.filter((r) => r.senti != null && r.senti <= 15).map((r) => r.name);
    if (os.length) parts.push(`${os.join('、')}情绪处于超卖区。`);
    if (s.nt_spike) parts.push(`沪深300 ETF 放量：${s.nt_spike}（当天成交额是前 20 日均额的倍数），疑似国家队托底，明早看宽基 ETF 净申购确认。`
      + (s.tuo ? `${s.tuo}近 6 天有 ★B，通达信图上标"托"：历史上之后 5 天上涨约 83%，但 60 天只有 25%，只适合短线。` : ''));
    if (s.ice) parts.push(s.ice_idx
      ? `短线冰点（深蓝 B）：${s.ice_idx}。全市场跌停 ${f0(s.dt)} 家，多于涨停 ${f0(s.zt)} 家，指数已从 20 日高点回落 5% 以上。每个指数一年约 3 次，之后 5 天、20 天上涨的比例约 64%（平时约 52%），只作短线参考。`
      : `全市场跌停 ${f0(s.dt)} 家，多于涨停 ${f0(s.zt)} 家，但各指数都不符合深蓝 B 冰点的条件（刚出过 S 或 B、离 20 日高点不到 5%，或 10 天内已经出过），不算冰点信号。`);
    (us || []).forEach((r) => {
      if (/B/.test(r.signal)) parts.push(`美股：${r.name}出现 ${r.signal}（美股底部信号历史上较有效）。`);
      else if (/S/.test(r.signal)) parts.push(`美股：${r.name}出现 ${r.signal}（美股顶部信号历史上不可靠，多数时候之后仍在涨）。`);
    });
    if (s.crowd != null && s.crowd >= 48 && !s.crowd_mark) parts.push(s.crowd_warn
      ? `${s.crowd_mark ? '出现 ◆S 抱团顶：' : ''}A股拥挤度 ${f1(s.crowd)}%，且沪深300 在一年高点 5% 以内：资金高度抱团，2011 年以来这种情况 4 次里 3 次是阶段顶部。`
      : `A股拥挤度 ${f1(s.crowd)}%，但沪深300 离一年高点较远（${f1(s.hs300_dist_high)}%），更像下跌中成交集中到大盘股，不按顶部信号看。`);
    if (s.etf_net_yi != null) parts.push(`宽基 ETF ${s.etf_net_yi >= 0 ? '净申购' : '净赎回'}。`);
    return parts.join('');
  }

  function miniGroup(box, rows, list, colorOffset) {
    box.replaceChildren();
    // 先把四个格子都放进网格，再统一画，避免第一张图按整行宽度绘制
    const cells = list.map(([k, name]) => {
      const wrap = document.createElement('div'); wrap.style.minWidth = '0';
      const last = [...rows].reverse().find((r) => r[k] != null);
      const t = document.createElement('div'); t.className = 'rp-mini-t'; t.textContent = `${name} · 最新 ${last ? f1(last[k]) : '—'}`;
      const b = document.createElement('div'); b.className = 'rp-mini';
      wrap.append(t, b); box.appendChild(wrap); return b;
    });
    cells.forEach((b, i) => {
      const [k, name] = list[i];
      lineChart(b, rows, { height: 140, y: [0, 100], yTicks: [0, 15, 50, 93], refs: [15, 93], series: [{ key: k, label: name, color: C()[(colorOffset + i) % C().length], fmt: f1 }] });
    });
  }

  dash.onData(() => {
    pxKey = dash.params().px || pxKey; if (sel.value !== pxKey) sel.value = pxKey;
    const S = dash.data('summary'), I = dash.data('indexes'), Hh = dash.data('history'), B = dash.data('breadth'), E = dash.data('etf'), G = dash.data('signals'), D = dash.data('daily');

    if (S.status === 'ok' && S.data.length) setMark('[data-source="summary"][data-field="date"]', ymd(parse(S.data[0].date)));
    const take = document.getElementById('takeaway');
    if (S.status === 'ok' && I.status === 'ok' && S.data.length) {
      const items = alerts(S.data[0], I.data), box = document.getElementById('alert');
      document.getElementById('alert-list').replaceChildren(...items.map(([h, t]) => { const li = document.createElement('li'), bb = document.createElement('b'); bb.textContent = h + '。'; li.append(bb, t); return li; }));
      box.hidden = !items.length;
    }
    if (S.status === 'ok' && I.status === 'ok' && S.data.length) { take.textContent = takeaway(S.data[0], I.data, dash.data('us').status === 'ok' ? dash.data('us').data : []); take.classList.remove('dash-skeleton'); }

    if (D.status === 'ok') fillTable('#daily-table', D.data, (r) => [r.date, nv(r.sh, f2), nv(r.sh_pct, sgn2), nv(r.mid_temp, f1), nv(r.short_temp, f1), nv(r.heat, f1), nv(r.crowd, f1),
      nv(r.amount_yi, f0), nv(r.up, f0), nv(r.down, f0), nv(r.zt, f0), nv(r.dt, f0), nv(r.margin_yi, f0), nv(r.margin_chg_yi, sgn1), nv(r.etf_net_yi, sgn1), r.signals]);
    if (I.status === 'ok') fillTable('#idx-table', I.data, (r) => [r.name, r.group === '市值' ? '按市值' : r.group === '板块' ? '按板块' : r.group, f2(r.close), sgn2(r.pct), f1(r.senti), r.signal, r.wzone ? `${r.wzone.slice(0, 2)} ${mdShort(parse(r.wzone_since))}–${mdShort(parse(r.wzone_until))}` : '—',
      nv(r.adv, f0), nv(r.dec, f0), f1(r.dist_high), r.last_top ?? '—', r.last_s1 ?? '—', r.last_b3 ?? '—', r.last_b2 ?? '—', r.last_b1 ?? '—', r.last_m ?? '—']);
    if (G.status === 'ok') fillTable('#sig-table', G.data, (r) => [r.date, r.name, r.type]);
    const U = dash.data('us');
    if (U.status === 'ok') fillTable('#us-table', U.data, (r) => [r.name, r.date, f2(r.close), sgn2(r.pct), f1(r.senti), `${r.vol_name} ${f1(r.vol)}`, nv(r.temp, f1), r.signal,
      r.last_b ?? '—', r.last_s ?? '—', f1(r.dist_high), `${r.etf_name} ${r.etf_code}`, f2(r.etf_close), sgn2(r.etf_pct)]);
    if (I.status === 'ok') fillTable('#nt-table', I.data.filter((r) => r.nt_low != null && r.group !== '红利'), (r) => [r.name, f0(r.nt_cost), `${f0(r.nt_low)}（${mdShort(parse(r.nt_low_date))}）`, f2(r.close),
      sgn1(r.nt_vs_low * 100), `${r.nt_cost_broken ? '跌破过成本' : '未跌破成本'}，${r.nt_low_broken ? '跌破过最低点' : '未跌破最低点'}`]);
    const ntNote = document.getElementById('nt-note');
    if (S.status === 'ok' && S.data.length) {
      const s0 = S.data[0];
      ntNote.textContent = s0.nt_first === undefined ? '国家队防线将在下一次日报更新后显示。' : s0.nt_first ? `最近一轮国家队式入场：${ymd(parse(s0.nt_first))} 至 ${ymd(parse(s0.nt_last))}，共 ${s0.nt_days} 天，上交所宽基 ETF 合计净申购 ${f0(s0.nt_total_yi)} 亿元。成本价按申购额加权。历史上上证指数、上证50 的入场期最低点多数守住，创业板几乎每次都跌破；只有 4 轮样本，仅作参考价位。` : '2015 年以来未识别到国家队式入场。';
      ntNote.classList.remove('dash-skeleton');
    }

    const EV = dash.data('events');
    const evOverall = document.getElementById('ev-overall');
    // 每条事件两行：第一行时间、事件和数值，第二行整行写判断（窄屏时判断不会被挤到看不见）
    const evTable = (sel, rows, cells, empty) => {
      const body = document.querySelector(sel + ' tbody'), n = document.querySelectorAll(sel + ' thead th').length;
      if (!rows.length) { const tr = document.createElement('tr'), td = document.createElement('td'); td.colSpan = n; td.textContent = empty; tr.appendChild(td); body.replaceChildren(tr); return; }
      body.replaceChildren(...rows.flatMap((r) => {
        const tr = document.createElement('tr'); tr.className = 'ev-main';
        cells(r).forEach(([text, cls]) => { const td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; tr.appendChild(td); });
        const tj = document.createElement('tr'), td = document.createElement('td'), lab = document.createElement('span');
        tj.className = 'ev-judge'; td.colSpan = n; lab.textContent = r.judgment_src === 'rule' ? '基础判断：' : '判断：';
        td.append(lab, r.judgment || '暂无（规则不覆盖这类事件，定时任务运行时由 Claude 补充）'); tj.appendChild(td);
        return [tr, tj];
      }));
    };
    if (EV.status === 'ok') {
      const o = EV.data.find((r) => r.kind === '总评') || {};
      const vals = (...xs) => (xs.every((x) => x == null) ? '—' : xs.map((x) => (x == null ? '—' : String(x))).join(' / '));
      const done = EV.data.filter((r) => r.kind === '已公布'), next = EV.data.filter((r) => r.kind === '即将发生');
      evTable('#ev-done', done, (r) => [[r.time_text], [r.region], [r.event, 'ev-name'], [vals(r.actual, r.forecast, r.previous)],
        [r.surprise || '—', /高于/.test(r.surprise || '') ? 'up' : /低于/.test(r.surprise || '') ? 'down' : '']], '没有重要数据公布');
      evTable('#ev-next', next, (r) => [[r.time_text], [r.region], ['★'.repeat(Math.min(r.importance || 0, 5))], [r.event, 'ev-name'], [vals(r.forecast, r.previous)]], '日历里暂无重要事件');
      if (o.next_days) document.getElementById('ev-next-title').textContent = `未来 3 个交易日（${o.next_days}）`;
      evOverall.textContent = o.judgment ? `${o.judgment_src === 'rule' ? '基础总评' : '总评'}：${o.judgment}` : '总评由每日定时任务生成。';
      evOverall.classList.remove('dash-skeleton');
    } else if (EV.status === 'missing') { evOverall.textContent = '事件预警将在下一次日报更新后显示。'; evOverall.classList.remove('dash-skeleton'); }

    const ids = ['chart-sh', 'chart-temp', 'chart-senti-a', 'chart-senti-b', 'chart-senti-c', 'chart-senti-us', 'chart-heat', 'chart-crowd', 'chart-etf', 'chart-breadth', 'chart-limit'];
    const box = Object.fromEntries(ids.map((id) => [id, document.getElementById(id)]));
    if (Hh.status === 'ok') {
      ['chart-sh', 'chart-temp', 'chart-senti-a', 'chart-senti-b', 'chart-senti-c', 'chart-senti-us', 'chart-heat', 'chart-crowd'].forEach((id) => box[id].classList.remove('dash-skeleton'));
      const rows = Hh.data;
      const price = new Map(rows.map((r) => [r.date, r[pxKey]]));
      const markers = rows.filter((r) => r.sig_sh && SIG[r.sig_sh]).map((r) => ({ date: r.date, y: r.sh, sym: SIG[r.sig_sh].sym, color: SIG[r.sig_sh].color, below: !SIG[r.sig_sh].above }));
      lineChart(box['chart-sh'], rows, { height: 260, series: [{ key: 'sh', label: '上证指数', color: 'var(--color-fg)', width: 1.5, fmt: f2 }, { key: 'bbi_sh', label: '月线BBI', color: 'var(--cds-chart-muted)', width: 1.2, dash: '4 3', fmt: f2 }], markers, xbands: zoneBands(rows, 'wz_sh'),
        tipExtra: (r) => [...(r.sig_sh && SIG[r.sig_sh] ? [tipRow(null, '', SIG[r.sig_sh].label)] : []), ...(r.wz_sh ? [tipRow(null, '', r.wz_sh > 0 ? '周线顶部区域' : '周线底部区域')] : [])] });
      lineChart(box['chart-temp'], rows, { height: 260, y: [0, 100], yTicks: [0, 10, 20, 50, 80, 90, 100], endLabels: true, bands: [{ y0: 0, y1: 20, fill: C()[0] }, { y0: 80, y1: 100, fill: C()[1] }],
        series: [{ key: 'mid_temp', label: '中线', color: C()[0], fmt: f1 }, { key: 'short_temp', label: '短线', color: 'var(--cds-chart-muted)', width: 1.5, fmt: f1 }] });
      const recent = rows.slice(-120);
      miniGroup(box['chart-senti-a'], recent, [['s_sz50', '上证50'], ['s_hs300', '沪深300'], ['s_zz500', '中证500'], ['s_zz1000', '中证1000']], 0);
      miniGroup(box['chart-senti-b'], recent, [['s_sh', '上证指数'], ['s_sz', '深证成指'], ['s_cyb', '创业板指'], ['s_kc50', '科创50']], 4);
      miniGroup(box['chart-senti-c'], recent, [['s_dlv', '红利低波ETF']], 8);
      miniGroup(box['chart-senti-us'], recent, [['s_spx', '标普500 情绪'], ['s_ndx', '纳指 情绪']], 9);
      pairChart(box['chart-heat'], rows, price, { kind: 'line', y: [0, 100], yTicks: [0, 50, 90], bands: [{ y0: 90, y1: 100, fill: C()[1] }], series: [{ key: 'heat', label: '过热分数', color: C()[1], fmt: f1 }],
        tip: (r) => [tipRow(null, '过热分数', nv(r.heat, f1))] });
      pairChart(box['chart-crowd'], rows, price, { kind: 'line', y: [30, 60], yTicks: [35, 42, 48, 55], bands: [{ y0: 48, y1: 60, fill: C()[1] }],
        series: [{ key: 'crowd', label: '拥挤度', color: C()[3], fmt: f1 }], tip: (r) => [tipRow(null, '拥挤度', nv(r.crowd, f1) + '%')] });
      if (E.status === 'ok') {
        box['chart-etf'].classList.remove('dash-skeleton');
        pairChart(box['chart-etf'], E.data, price, { kind: 'bar', barKey: 'net_yi', pos: 'var(--color-bad)', neg: 'var(--color-ok)',
          tip: (r) => [tipRow(null, '净申购', nv(r.net_yi, sgn1) + ' 亿元'), tipRow(null, '其中沪深300类', nv(r.net_300_yi, sgn1) + ' 亿元'), tipRow(null, '成交额倍数（中位）', nv(r.ratio_med, f2))] });
      } else if (E.status === 'error') fail(box['chart-etf']);
      if (B.status === 'ok') {
        box['chart-breadth'].classList.remove('dash-skeleton'); box['chart-limit'].classList.remove('dash-skeleton');
        const br = B.data.map((r) => ({ ...r, net: (r.up ?? 0) - (r.down ?? 0) }));
        pairChart(box['chart-breadth'], br, price, { kind: 'bar', barKey: 'net', pos: 'var(--color-bad)', neg: 'var(--color-ok)', tip: (r) => [tipRow(null, '上涨', f0(r.up)), tipRow(null, '下跌', f0(r.down))] });
        pairChart(box['chart-limit'], B.data, price, { kind: 'line', series: [{ key: 'zt', label: '涨停', color: C()[1] }, { key: 'dt', label: '跌停', color: C()[0] }],
          tip: (r) => [tipRow(C()[1], '涨停', f0(r.zt)), tipRow(C()[0], '跌停', f0(r.dt)), tipRow(null, '炸板', f0(r.zb)), tipRow(null, '最高连板', f0(r.max_lb))] });
      } else if (B.status === 'error') { fail(box['chart-breadth']); fail(box['chart-limit']); }
    } else if (Hh.status === 'error') ids.forEach((id) => fail(box[id]));
  });
})();
</script>
